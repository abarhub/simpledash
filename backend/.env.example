# Copier en .env (non versionné) et renseigner les valeurs.
# Un domaine dont les variables ne sont pas renseignées reste vide (pas
# d'erreur), il n'apparaît juste sans ressource à sélectionner.

# Jira Server / Data Center - Personal Access Token
JIRA_BASE_URL=https://jira.exemple.local
JIRA_TOKEN=

# Bitbucket Server / Data Center - Personal Access Token
# BITBUCKET_USERNAME doit être le "slug" du compte (identifiant technique,
# pas le nom affiché) — obligatoire depuis Bitbucket Data Center 8.x.
BITBUCKET_BASE_URL=https://bitbucket.exemple.local
BITBUCKET_TOKEN=
BITBUCKET_USERNAME=
